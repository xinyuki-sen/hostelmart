# ====================================================================
# HOSTELMART ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development. Never push to Git!
# ====================================================================

# 1. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cryptographic Secret for HTTP-Only Session Tokens (Min 32 characters)
JWT_SECRET_KEY=hostelmart_ultra_secure_session_token_secret_key_32_chars_min!

# 3. Application Domain
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
